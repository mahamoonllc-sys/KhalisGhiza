{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .feature-strip-{{ section.id }} .feature-strip__list {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 3rem 2rem;
    list-style: none;
    margin: 0;
    padding: 0;
    text-align: center;
  }

  @media screen and (min-width: 750px) {
    .feature-strip-{{ section.id }} .feature-strip__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .feature-strip-{{ section.id }} .feature-strip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.8rem;
  }

  .feature-strip-{{ section.id }} .feature-strip__icon .svg-wrapper svg {
    width: 3.6rem;
    height: 3.6rem;
  }

  .feature-strip-{{ section.id }} .feature-strip__heading {
    margin: 0;
    font-size: 1.6rem;
  }

  .feature-strip-{{ section.id }} .feature-strip__text {
    margin: 0;
    font-size: 1.3rem;
    opacity: 0.75;
  }
{%- endstyle -%}

<div class="feature-strip-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.blocks.size > 0 -%}
      <ul class="feature-strip__list">
        {%- for block in section.blocks -%}
          <li class="feature-strip__item" {{ block.shopify_attributes }}>
            {%- if block.settings.icon != 'none' -%}
              <div class="feature-strip__icon">
                {%- render 'icon-accordion', icon: block.settings.icon -%}
              </div>
            {%- endif -%}
            {%- if block.settings.heading != blank -%}
              <p class="feature-strip__heading">{{ block.settings.heading | escape }}</p>
            {%- endif -%}
            {%- if block.settings.text != blank -%}
              <p class="feature-strip__text">{{ block.settings.text | escape }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Feature strip",
  "class": "section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-6"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "check_mark", "label": "Check mark" },
            { "value": "price_tag", "label": "Price tag" },
            { "value": "truck", "label": "Truck" },
            { "value": "return", "label": "Return" },
            { "value": "box", "label": "Box" },
            { "value": "lock", "label": "Lock" },
            { "value": "heart", "label": "Heart" },
            { "value": "recycle", "label": "Recycle" },
            { "value": "star", "label": "Star" }
          ],
          "default": "check_mark"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "100% Organic"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Certified pure products"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Feature strip",
      "blocks": [
        { "type": "badge", "settings": { "icon": "leaf", "heading": "100% Organic", "text": "Certified pure products" } },
        { "type": "badge", "settings": { "icon": "lock", "heading": "Secure Payments", "text": "All major cards accepted" } },
        { "type": "badge", "settings": { "icon": "truck", "heading": "Fast Delivery", "text": "Nationwide shipping" } },
        { "type": "badge", "settings": { "icon": "return", "heading": "Cash on Delivery", "text": "Pay when you receive" } }
      ]
    }
  ]
}
{% endschema %}
