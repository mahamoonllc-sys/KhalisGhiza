{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .shop-the-feed-{{ section.id }} .shop-the-feed__list {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 65%;
    gap: 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (min-width: 750px) {
    .shop-the-feed-{{ section.id }} .shop-the-feed__list {
      grid-auto-columns: 30%;
    }
  }

  @media screen and (min-width: 990px) {
    .shop-the-feed-{{ section.id }} .shop-the-feed__list {
      grid-auto-columns: 22%;
    }
  }

  .shop-the-feed-{{ section.id }} .shop-the-feed__card {
    position: relative;
    display: block;
    text-decoration: none;
    color: inherit;
    border-radius: var(--media-radius);
    overflow: hidden;
  }

  .shop-the-feed-{{ section.id }} .shop-the-feed__media {
    aspect-ratio: 4 / 5;
    background: rgba(var(--color-foreground), 0.05);
  }

  .shop-the-feed-{{ section.id }} .shop-the-feed__media img,
  .shop-the-feed-{{ section.id }} .shop-the-feed__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .shop-the-feed-{{ section.id }} .shop-the-feed__info {
    padding: 1rem 0.2rem;
  }

  .shop-the-feed-{{ section.id }} .shop-the-feed__title {
    font-size: 1.4rem;
    margin: 0 0 0.3rem;
  }
{%- endstyle -%}

<div class="shop-the-feed-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
  <div class="page-width section-{{ section.id }}-padding">
    {%- if section.settings.title != blank or section.settings.subheading != blank -%}
      <div class="title-wrapper-with-link title-wrapper--no-top-margin">
        {%- if section.settings.title != blank -%}
          <h2 class="title inline-richtext {{ section.settings.heading_size }}">{{ section.settings.title }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="rte">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <slider-component class="slider-mobile-gutter">
        <ul id="Slider-{{ section.id }}" class="shop-the-feed__list slider slider--everywhere" role="list">
          {%- for block in section.blocks -%}
            {%- assign product = block.settings.product -%}
            <li
              id="Slide-{{ section.id }}-{{ forloop.index }}"
              class="shop-the-feed__item slider__slide"
              {{ block.shopify_attributes }}
            >
              <a
                class="shop-the-feed__card"
                {% if product != blank %}
                  href="{{ product.url }}"
                {% else %}
                  role="link" aria-disabled="true"
                {% endif %}
              >
                <div class="shop-the-feed__media">
                  {%- if block.settings.video != blank -%}
                    <video
                      src="{{ block.settings.video.sources[1].url | default: block.settings.video.sources[0].url }}"
                      autoplay
                      muted
                      loop
                      playsinline
                    ></video>
                  {%- elsif block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 800
                      | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 65vw'
                    }}
                  {%- elsif product != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 800
                      | image_tag: loading: 'lazy', sizes: '(min-width: 990px) 22vw, (min-width: 750px) 30vw, 65vw'
                    }}
                  {%- else -%}
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="shop-the-feed__info">
                  <p class="shop-the-feed__title">
                    {{ block.settings.title | default: product.title | escape }}
                  </p>
                  {%- if product != blank -%}
                    {% render 'price', product: product, price_class: '' %}
                  {%- endif -%}
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>
        <div class="slider-buttons">
          <button type="button" class="slider-button slider-button--prev" name="previous" aria-label="{{ 'general.slider.previous_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
          <div class="slider-counter caption">
            <span class="slider-counter--current">1</span>
            <span aria-hidden="true"> / </span>
            <span class="visually-hidden">{{ 'general.slider.of' | t }}</span>
            <span class="slider-counter--total">{{ section.blocks.size }}</span>
          </div>
          <button type="button" class="slider-button slider-button--next" name="next" aria-label="{{ 'general.slider.next_slide' | t }}" aria-controls="Slider-{{ section.id }}">
            <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
          </button>
        </div>
      </slider-component>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop the feed",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Heading",
      "default": "See Our Products"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "feed_item",
      "name": "Feed item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image (overrides product image)"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video (overrides image)"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title (overrides product title)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop the feed",
      "blocks": [
        { "type": "feed_item" },
        { "type": "feed_item" },
        { "type": "feed_item" },
        { "type": "feed_item" }
      ]
    }
  ]
}
{% endschema %}
