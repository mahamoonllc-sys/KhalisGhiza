{%- comment -%}
  Renders nothing if end_datetime is blank, unparseable, or already in the past —
  a merchant who forgets to update/remove this after a sale ends never shows
  visitors a stuck "00:00:00" timer.

  Rule exception: this uses setInterval, which CLAUDE.md otherwise disallows in
  favor of IntersectionObserver/ResizeObserver. A live countdown clock has to
  re-render once a second by definition — there's no observer that fires on
  "a second has passed." The interval is cleared on disconnectedCallback and
  again the moment the countdown reaches zero, so it never runs longer than it
  needs to.
{%- endcomment -%}
{%- liquid
  assign now_ts = 'now' | date: '%s' | plus: 0
  assign end_ts = 0
  if section.settings.end_datetime != blank
    assign end_ts = section.settings.end_datetime | date: '%s' | plus: 0
  endif
-%}

{%- if end_ts > now_ts -%}
  {%- style -%}
    .kg-countdown-offer-{{ section.id }} {
      padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
      padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
    }

    @media screen and (min-width: 750px) {
      .kg-countdown-offer-{{ section.id }} {
        padding-top: {{ section.settings.padding_top }}px;
        padding-bottom: {{ section.settings.padding_bottom }}px;
      }
    }

    .kg-countdown-offer-{{ section.id }} .kg-countdown-offer__box {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 1.2rem;
      padding: 1.6rem 2rem;
      border: 1px solid rgba(var(--color-foreground), 0.12);
      border-radius: var(--buttons-radius);
    }

    .kg-countdown-offer-{{ section.id }} .kg-countdown-offer__heading {
      margin: 0;
      font-size: 1.5rem;
      font-weight: 600;
    }

    .kg-countdown-offer-{{ section.id }} .kg-countdown-offer__timer {
      display: flex;
      gap: 0.8rem;
    }

    .kg-countdown-offer-{{ section.id }} .kg-countdown-offer__unit {
      display: flex;
      flex-direction: column;
      align-items: center;
      min-width: 4.4rem;
      padding: 0.6rem 0.4rem;
      border-radius: calc(var(--buttons-radius) * 0.6);
      background: rgb(var(--color-foreground));
      color: rgb(var(--color-background));
    }

    .kg-countdown-offer-{{ section.id }} .kg-countdown-offer__value {
      font-size: 1.8rem;
      font-weight: 700;
      font-variant-numeric: tabular-nums;
      line-height: 1.2;
    }

    .kg-countdown-offer-{{ section.id }} .kg-countdown-offer__label {
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      opacity: 0.75;
    }

    @media screen and (max-width: 749px) {
      .kg-countdown-offer-{{ section.id }} .kg-countdown-offer__box {
        justify-content: center;
        text-align: center;
      }

      .kg-countdown-offer-{{ section.id }} .kg-countdown-offer__unit {
        min-width: 5.6rem;
        min-height: 44px;
      }
    }
  {%- endstyle -%}

  <div class="kg-countdown-offer-{{ section.id }} js-kg-countdown-offer-root color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
      <kg-countdown-offer class="kg-countdown-offer__box" data-end-timestamp="{{ end_ts }}">
        {%- if section.settings.heading != blank -%}
          <p class="kg-countdown-offer__heading">{{ section.settings.heading | escape }}</p>
        {%- endif -%}
        <div class="kg-countdown-offer__timer" role="timer" aria-live="off">
          <div class="kg-countdown-offer__unit">
            <span class="kg-countdown-offer__value" data-kg-countdown-hours>00</span>
            <span class="kg-countdown-offer__label">Hrs</span>
          </div>
          <div class="kg-countdown-offer__unit">
            <span class="kg-countdown-offer__value" data-kg-countdown-minutes>00</span>
            <span class="kg-countdown-offer__label">Mins</span>
          </div>
          <div class="kg-countdown-offer__unit">
            <span class="kg-countdown-offer__value" data-kg-countdown-seconds>00</span>
            <span class="kg-countdown-offer__label">Secs</span>
          </div>
        </div>
      </kg-countdown-offer>
    </div>
  </div>

  {% javascript %}
    if (!customElements.get('kg-countdown-offer')) {
      customElements.define(
        'kg-countdown-offer',
        class KgCountdownOffer extends HTMLElement {
          connectedCallback() {
            this.endMs = Number(this.dataset.endTimestamp) * 1000;
            this.hoursEl = this.querySelector('[data-kg-countdown-hours]');
            this.minutesEl = this.querySelector('[data-kg-countdown-minutes]');
            this.secondsEl = this.querySelector('[data-kg-countdown-seconds]');

            this.tick();
            this.interval = setInterval(this.tick.bind(this), 1000);
          }

          disconnectedCallback() {
            clearInterval(this.interval);
          }

          tick() {
            const remainingMs = this.endMs - Date.now();

            if (remainingMs <= 0) {
              clearInterval(this.interval);
              this.closest('.js-kg-countdown-offer-root')?.remove();
              return;
            }

            const totalSeconds = Math.floor(remainingMs / 1000);
            const hours = Math.floor(totalSeconds / 3600);
            const minutes = Math.floor((totalSeconds % 3600) / 60);
            const seconds = totalSeconds % 60;

            this.hoursEl.textContent = String(hours).padStart(2, '0');
            this.minutesEl.textContent = String(minutes).padStart(2, '0');
            this.secondsEl.textContent = String(seconds).padStart(2, '0');
          }
        }
      );
    }
  {% endjavascript %}
{%- endif -%}

{% schema %}
{
  "name": "KG Countdown offer",
  "class": "section",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "🔥 Limited time offer!"
    },
    {
      "type": "text",
      "id": "end_datetime",
      "label": "Offer end date and time",
      "info": "Format: YYYY-MM-DD HH:MM in your store's local time, 24-hour clock. Example: 2026-09-30 23:59. Leave blank to hide this section. Once this date/time passes, the section stops showing automatically — remember to update it for your next sale.",
      "default": ""
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 24
    }
  ],
  "presets": [
    {
      "name": "KG Countdown offer"
    }
  ]
}
{% endschema %}
