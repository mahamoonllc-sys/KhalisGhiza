{%- style -%}
  .marquee-{{ section.id }} {
    --marquee-speed: {{ section.settings.speed }}s;
    overflow: hidden;
    position: relative;
  }

  .marquee-{{ section.id }} .marquee__track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: marquee-scroll-{{ section.id }} var(--marquee-speed) linear infinite;
  }

  .marquee-{{ section.id }}:hover .marquee__track,
  .marquee-{{ section.id }}:focus-within .marquee__track {
    animation-play-state: paused;
  }

  .marquee-{{ section.id }} .marquee__group {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  .marquee-{{ section.id }} .marquee__item {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 1rem 3rem;
    font-size: 1.4rem;
    font-weight: 600;
    white-space: nowrap;
  }

  .marquee-{{ section.id }} .marquee__item a {
    color: inherit;
    text-decoration: none;
  }

  @keyframes marquee-scroll-{{ section.id }} {
    from {
      transform: translateX(0);
    }
    to {
      transform: translateX(-50%);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .marquee-{{ section.id }} .marquee__track {
      animation: none;
      overflow-x: auto;
    }
  }
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="marquee-{{ section.id }} color-{{ section.settings.color_scheme }}" role="region" aria-label="{{ 'sections.header.announcement' | t }}">
    <div class="marquee__track">
      {%- for i in (1..2) -%}
        <div class="marquee__group" {% if i == 2 %}aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <div class="marquee__item" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
              {%- if block.settings.icon != blank -%}<span>{{ block.settings.icon }}</span>{%- endif -%}
              {%- if block.settings.text != blank -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement marquee",
  "class": "announcement-marquee-section",
  "max_blocks": 12,
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-9"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Scroll duration",
      "default": 25
    }
  ],
  "blocks": [
    {
      "type": "message",
      "name": "Message",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Emoji/icon",
          "default": "🚚"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping over Rs. 3,000"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement marquee",
      "blocks": [
        { "type": "message", "settings": { "icon": "🚚", "text": "Free Shipping Over Rs. 3,000" } },
        { "type": "message", "settings": { "icon": "🔒", "text": "100% Secure Checkout" } },
        { "type": "message", "settings": { "icon": "📦", "text": "Fast Nationwide Delivery" } },
        { "type": "message", "settings": { "icon": "⭐", "text": "Trusted by Thousands of Customers" } }
      ]
    }
  ]
}
{% endschema %}
