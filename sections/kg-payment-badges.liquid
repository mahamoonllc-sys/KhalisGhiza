{%- comment -%}
  Real payment icons only — shop.enabled_payment_types reflects whatever
  payment providers are actually turned on in Settings > Payments, the same
  source Dawn's own footer.liquid uses (sections/footer.liquid:290-294). This
  will not show a Cash on Delivery icon or Pakistani wallets (JazzCash,
  EasyPaisa) unless Shopify recognizes them as a payment type with an icon —
  it only ever shows real, currently-enabled card/wallet networks, never a
  fabricated badge row.
{%- endcomment -%}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .kg-payment-badges-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .kg-payment-badges-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .kg-payment-badges-{{ section.id }} .kg-payment-badges__box {
    text-align: center;
  }

  .kg-payment-badges-{{ section.id }} .kg-payment-badges__heading {
    margin: 0 0 1rem;
    font-size: 1.2rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    opacity: 0.7;
  }

  .kg-payment-badges-{{ section.id }} .list-payment {
    justify-content: center;
  }
{%- endstyle -%}

{%- if shop.enabled_payment_types.size > 0 -%}
  <div class="kg-payment-badges-{{ section.id }} color-{{ section.settings.color_scheme }} gradient">
    <div class="page-width">
      <div class="kg-payment-badges__box">
        {%- if section.settings.heading != blank -%}
          <p class="kg-payment-badges__heading">{{ section.settings.heading | escape }}</p>
        {%- endif -%}
        <ul class="list list-payment" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li class="list-payment__item">
              {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "KG Payment badges",
  "class": "section",
  "tag": "section",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Guaranteed safe & secure checkout with"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "Padding"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    }
  ],
  "presets": [
    {
      "name": "KG Payment badges"
    }
  ]
}
{% endschema %}
