{%- comment -%}
  Renders one of the kg-trust-badges icon set as inline SVG.
  Accepts: icon (string) — one of: truck, shield, leaf, box, star, heart, clock, check
{%- endcomment -%}
{%- case icon -%}
  {%- when 'truck' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <rect x="1.5" y="6.5" width="12.5" height="9"></rect>
      <path d="M14 9.5h3.7l3.3 3.5v2.5H14z"></path>
      <circle cx="6.5" cy="18" r="1.75"></circle>
      <circle cx="16.75" cy="18" r="1.75"></circle>
    </svg>
  {%- when 'shield' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 2.5l7.5 3v5.2c0 5-3.2 8.6-7.5 10.3-4.3-1.7-7.5-5.3-7.5-10.3V5.5z"></path>
    </svg>
  {%- when 'leaf' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4 20c0-9 5-15 15-16 1 10-5 15-14 15-.7 0-1.4-.03-2-.08z"></path>
      <path d="M6 18c4-4 7-8 10-12"></path>
    </svg>
  {%- when 'box' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M3 7.5 12 3l9 4.5-9 4.5-9-4.5z"></path>
      <path d="M3 7.5v9L12 21l9-4.5v-9"></path>
      <path d="M12 12v9"></path>
    </svg>
  {%- when 'star' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 3l2.6 5.6 6.1.6-4.6 4.1 1.3 6-5.4-3.2-5.4 3.2 1.3-6-4.6-4.1 6.1-.6z"></path>
    </svg>
  {%- when 'heart' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M12 20.5C6 16.8 2.5 13.3 2.5 9.4 2.5 6.6 4.7 4.5 7.4 4.5c1.6 0 3.1.8 4.1 2.1a5 5 0 0 1 4.1-2.1c2.7 0 4.9 2.1 4.9 4.9 0 3.9-3.5 7.4-9.5 11.1z"></path>
    </svg>
  {%- when 'clock' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <circle cx="12" cy="12" r="9"></circle>
      <path d="M12 7v5l3.5 2"></path>
    </svg>
  {%- when 'check' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
      <path d="M4.5 12.5l5 5 10-11"></path>
    </svg>
{%- endcase -%}
