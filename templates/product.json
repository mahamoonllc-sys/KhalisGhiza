{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "title": {
          "type": "title",
          "settings": {}
        },
        "rating": {
          "type": "rating",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "inventory": {
          "type": "inventory",
          "settings": {
            "text_style": "uppercase",
            "inventory_threshold": 10,
            "show_inventory_quantity": true
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": true
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "shipping_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Shipping & Delivery",
            "icon": "truck",
            "content": "<p>Orders are hygienically packed and shipped nationwide. Cash on delivery is available alongside secure online payment options.</p>"
          }
        },
        "storage_tab": {
          "type": "collapsible_tab",
          "settings": {
            "heading": "Storage & Freshness",
            "icon": "box",
            "content": "<p>Store in a cool, dry place away from direct sunlight. Reseal the packaging tightly after opening to keep the product fresh for longer.</p>"
          }
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Share"
          }
        },
        "buy_box_extras": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "<div class=\"bbx\" id=\"BuyBoxExtras-{{ section.id }}\">\n  <style>\n    #MainProduct-{{ section.id }} .product-form__submit {\n      background: #264D40;\n      border-color: #264D40;\n      color: #ffffff;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-buy-now {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      width: 100%;\n      margin-top: 1rem;\n      padding: 1.4rem;\n      border: none;\n      border-radius: var(--buttons-radius, 0);\n      background: #E67E22;\n      color: #ffffff;\n      font-weight: 700;\n      text-transform: uppercase;\n      cursor: pointer;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-buy-now[disabled] {\n      opacity: 0.6;\n      cursor: not-allowed;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-whatsapp {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 0.6rem;\n      width: 100%;\n      margin-top: 1rem;\n      padding: 1.3rem;\n      border: 0.1rem solid #25D366;\n      border-radius: var(--buttons-radius, 0);\n      background: #ffffff;\n      color: #25D366;\n      font-weight: 600;\n      text-decoration: none;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-badges {\n      display: grid;\n      grid-template-columns: repeat(4, 1fr);\n      gap: 1rem;\n      margin: 1.6rem 0;\n      text-align: center;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-badge-circle {\n      width: 4.4rem;\n      height: 4.4rem;\n      margin: 0 auto 0.6rem;\n      border-radius: 50%;\n      background: rgba(var(--color-foreground), 0.06);\n      display: flex;\n      align-items: center;\n      justify-content: center;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-badge-circle svg {\n      width: 2rem;\n      height: 2rem;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-badge-label {\n      font-size: 1.1rem;\n      font-weight: 600;\n      line-height: 1.3;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-countdown {\n      display: flex;\n      align-items: center;\n      justify-content: space-between;\n      gap: 1rem;\n      padding: 1rem 1.5rem;\n      margin: 1.2rem 0;\n      border: 0.1rem solid #f5d7b5;\n      border-radius: 0.8rem;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-countdown-label {\n      font-size: 1.2rem;\n      font-weight: 700;\n      text-transform: uppercase;\n      color: #e28f3c;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-countdown-units {\n      display: flex;\n      gap: 0.6rem;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-countdown-unit {\n      display: flex;\n      flex-direction: column;\n      align-items: center;\n      gap: 0.3rem;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-countdown-box {\n      min-width: 3.2rem;\n      padding: 0.4rem 0.6rem;\n      border-radius: 0.6rem;\n      background: #0b3724;\n      color: #ffffff;\n      font-weight: 800;\n      text-align: center;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-countdown-unit-label {\n      font-size: 0.9rem;\n      font-weight: 700;\n      text-transform: uppercase;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-delivery {\n      display: flex;\n      align-items: center;\n      gap: 0.8rem;\n      padding: 1rem 1.5rem;\n      margin: 1.2rem 0;\n      border: 0.1rem solid rgba(var(--color-foreground), 0.15);\n      border-radius: 0.8rem;\n      font-size: 1.3rem;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-payment {\n      text-align: center;\n      padding: 1.2rem;\n      margin: 1.2rem 0;\n      border: 0.1rem solid rgba(var(--color-foreground), 0.15);\n      border-radius: 0.8rem;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-payment-caption {\n      font-size: 1.1rem;\n      font-weight: 700;\n      text-transform: uppercase;\n      opacity: 0.7;\n      margin-bottom: 0.8rem;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-payment-icons {\n      display: flex;\n      align-items: center;\n      justify-content: center;\n      gap: 1rem;\n      flex-wrap: wrap;\n    }\n    #BuyBoxExtras-{{ section.id }} .bbx-payment-icons svg,\n    #BuyBoxExtras-{{ section.id }} .bbx-payment-icons img {\n      height: 2.4rem;\n      width: auto;\n    }\n  </style>\n\n  <button type=\"button\" class=\"bbx-buy-now\" data-bbx-buy-now data-section-id=\"{{ section.id }}\">\n    Buy Now\n  </button>\n\n  <a\n    href=\"https://wa.me/92XXXXXXXXXX?text={{ 'Hi, I am interested in ' | append: product.title | url_encode }}\"\n    target=\"_blank\"\n    rel=\"noopener\"\n    class=\"bbx-whatsapp\"\n  >\n    <span aria-hidden=\"true\">💬</span> Order via WhatsApp\n  </a>\n  <!-- Replace 92XXXXXXXXXX above with your real WhatsApp number (country code, no + or spaces) -->\n\n  <div class=\"bbx-badges\">\n    <div class=\"bbx-badge-item\">\n      <div class=\"bbx-badge-circle\">{% render 'icon-accordion', icon: 'return' %}</div>\n      <p class=\"bbx-badge-label\">50% Return<br>Customers</p>\n    </div>\n    <div class=\"bbx-badge-item\">\n      <div class=\"bbx-badge-circle\">{% render 'icon-accordion', icon: 'lock' %}</div>\n      <p class=\"bbx-badge-label\">Cash On<br>Delivery</p>\n    </div>\n    <div class=\"bbx-badge-item\">\n      <div class=\"bbx-badge-circle\">{% render 'icon-accordion', icon: 'star' %}</div>\n      <p class=\"bbx-badge-label\">Years Of<br>Excellence</p>\n    </div>\n    <div class=\"bbx-badge-item\">\n      <div class=\"bbx-badge-circle\">{% render 'icon-accordion', icon: 'heart' %}</div>\n      <p class=\"bbx-badge-label\">Happy<br>Customers</p>\n    </div>\n  </div>\n\n  <!-- Countdown only shows while \"now\" is before the end date/time below.\n       Set this to a REAL offer end date - it will not fake-reset per visitor. -->\n  <div class=\"bbx-countdown\" data-bbx-countdown data-end=\"2026-12-31T23:59:59\">\n    <span class=\"bbx-countdown-label\">Limited Time Offer!</span>\n    <div class=\"bbx-countdown-units\">\n      <div class=\"bbx-countdown-unit\">\n        <span class=\"bbx-countdown-box\" data-bbx-hrs>00</span>\n        <span class=\"bbx-countdown-unit-label\">Hrs</span>\n      </div>\n      <div class=\"bbx-countdown-unit\">\n        <span class=\"bbx-countdown-box\" data-bbx-mins>00</span>\n        <span class=\"bbx-countdown-unit-label\">Mins</span>\n      </div>\n      <div class=\"bbx-countdown-unit\">\n        <span class=\"bbx-countdown-box\" data-bbx-secs>00</span>\n        <span class=\"bbx-countdown-unit-label\">Secs</span>\n      </div>\n    </div>\n  </div>\n\n  <!-- Delivery estimate: calculated for real from today's date + processing/shipping days below -->\n  <div class=\"bbx-delivery\" data-bbx-delivery data-processing-days=\"1\" data-shipping-days=\"2\">\n    <span aria-hidden=\"true\">🚚</span>\n    <span data-bbx-delivery-text>Calculating delivery estimate…</span>\n  </div>\n\n  <div class=\"bbx-payment\">\n    <p class=\"bbx-payment-caption\">Guaranteed safe &amp; secure checkout with</p>\n    <div class=\"bbx-payment-icons\">\n      {%- for type in shop.enabled_payment_types -%}\n        {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}\n      {%- endfor -%}\n    </div>\n  </div>\n</div>\n\n<script>\n  (function () {\n    var root = document.getElementById('BuyBoxExtras-{{ section.id }}');\n    if (!root || root.dataset.bbxInit) return;\n    root.dataset.bbxInit = 'true';\n\n    var buyNowButton = root.querySelector('[data-bbx-buy-now]');\n    if (buyNowButton) {\n      buyNowButton.addEventListener('click', function () {\n        var form = document.querySelector('#MainProduct-{{ section.id }} form[data-type=\"add-to-cart-form\"]');\n        var variantInput = form ? form.querySelector('[name=\"id\"]') : null;\n        var quantityInput = document.querySelector('#Quantity-{{ section.id }}');\n        if (!variantInput || !variantInput.value) return;\n\n        buyNowButton.disabled = true;\n        buyNowButton.textContent = 'Adding…';\n\n        fetch('/cart/add.js', {\n          method: 'POST',\n          headers: { 'Content-Type': 'application/json' },\n          body: JSON.stringify({\n            id: variantInput.value,\n            quantity: quantityInput ? parseInt(quantityInput.value, 10) || 1 : 1\n          })\n        })\n          .then(function (response) {\n            if (!response.ok) throw new Error('add to cart failed');\n            window.location.href = '/checkout';\n          })\n          .catch(function () {\n            buyNowButton.disabled = false;\n            buyNowButton.textContent = 'Buy Now';\n          });\n      });\n    }\n\n    var countdown = root.querySelector('[data-bbx-countdown]');\n    if (countdown) {\n      var end = new Date(countdown.dataset.end).getTime();\n      var hrsEl = countdown.querySelector('[data-bbx-hrs]');\n      var minsEl = countdown.querySelector('[data-bbx-mins]');\n      var secsEl = countdown.querySelector('[data-bbx-secs]');\n      var pad = function (n) { return String(n).padStart(2, '0'); };\n      var timer;\n      var tick = function () {\n        var diff = end - Date.now();\n        if (isNaN(end) || diff <= 0) {\n          countdown.style.display = 'none';\n          clearInterval(timer);\n          return;\n        }\n        var hrs = Math.floor(diff / 3600000);\n        var mins = Math.floor((diff % 3600000) / 60000);\n        var secs = Math.floor((diff % 60000) / 1000);\n        if (hrsEl) hrsEl.textContent = pad(hrs);\n        if (minsEl) minsEl.textContent = pad(mins);\n        if (secsEl) secsEl.textContent = pad(secs);\n      };\n      tick();\n      timer = setInterval(tick, 1000);\n    }\n\n    var delivery = root.querySelector('[data-bbx-delivery]');\n    if (delivery) {\n      var processingDays = parseInt(delivery.dataset.processingDays, 10) || 1;\n      var shippingDays = parseInt(delivery.dataset.shippingDays, 10) || 2;\n      var addBusinessDays = function (date, days) {\n        var result = new Date(date);\n        var added = 0;\n        while (added < days) {\n          result.setDate(result.getDate() + 1);\n          var day = result.getDay();\n          if (day !== 0 && day !== 6) added++;\n        }\n        return result;\n      };\n      var start = addBusinessDays(new Date(), processingDays);\n      var end2 = addBusinessDays(start, shippingDays);\n      var options = { weekday: 'short', month: 'short', day: 'numeric' };\n      var text = 'Estimated delivery: ' + start.toLocaleDateString(undefined, options) + ' – ' + end2.toLocaleDateString(undefined, options) + ' (excl. weekends)';\n      var textEl = delivery.querySelector('[data-bbx-delivery-text]');\n      if (textEl) textEl.textContent = text;\n    }\n  })();\n</script>\n"
          }
        }
      },
      "block_order": [
        "title",
        "rating",
        "price",
        "inventory",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "buy_box_extras",
        "description",
        "shipping_tab",
        "storage_tab",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": true,
        "media_fit": "contain",
        "gallery_layout": "thumbnail_slider",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": true,
        "enable_video_looping": false,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "disclosures": {
      "type": "disclosures",
      "settings": {
        "padding_top": 36,
        "padding_bottom": 0
      }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "You May Also Like",
        "heading_size": "h1",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "square",
        "image_shape": "arch",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": true,
        "padding_top": 36,
        "padding_bottom": 28
      }
    }
  },
  "order": [
    "main",
    "disclosures",
    "related-products"
  ]
}
